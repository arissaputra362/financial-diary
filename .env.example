# Financial Planner MVP — Environment Variables
# ---------------------------------------------------------------
# Cara pakai: copy isi file ini ke `.env` di folder yang sama,
# lalu ganti setiap <ISI_DI_SINI> dengan value asli.
# File .env.* TIDAK pernah di-commit (gitignore). Jangan share key.
# Saat deployment di Vercel, isi variabel yang sama di project settings
# (ADR-007); key tidak perlu digenerate ulang, cukup paste yang sama.
# ---------------------------------------------------------------

# ── Neon.tech PostgreSQL (WAJIB — sudah terpasang) ──────────────
# Console Neon: https://console.neon.tech → Project → Connection string
# Bentuk value: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth (WAJIB — dipakai T-004 yang sudah selesai) ─────────────
# Secret untuk JWT session (ADR-002). Minimal 32 karakter acak.
# Generate di PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=<ISI hasil generator di sini>

# ── Google Gemini API (perlu sebelum T-006) ─────────────────────
# https://aistudio.google.com/apikey → "Create API key" (free tier)
# Dipakai untuk: OCR struk (T-006, vision) + advisor (T-007, structured output)
GEMINI_API_KEY=<ISI dari Google AI Studio>

# Model default; biarkan kecuali verifikasi menunjukkan model lain yang tersedia.
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback model (opsional): hanya dipakai saat model utama gagal sebab
# spesifik-model (HTTP 429 kuota/rate limit, 404 model pensiun, 503 unavailable).
# Pisahkan beberapa model dengan koma; rantai utama+fallback maksimal 3 model.
# Kosong/tidak di-set = default gemini-3.1-flash-lite.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite

# ── Vercel Blob (perlu sebelum T-006) ──────────────────────────
# Vercel Dashboard → Project → Storage → Blob → Create token
# Dipakai untuk simpan foto struk user (≤4MB, ADR-008)
BLOB_READ_WRITE_TOKEN=<ISI dari Vercel Blob>

# ── Gold Market Price API (Fitur 8) ──────────────────────────
# Emas API ID (harga bersumber dari Logam Mulia; cache hasil harian di database)
GOLD_PRICE_API_BASE_URL=https://emas.maulanar.my.id
GOLD_PRICE_API_KEY=


# ── Catatan ────────────────────────────────────────────────────
# • .env yang benar adalah .env (bukan .env.local) — build membaca "Environments: .env"
# • Jangan pernah share file .env asli atau paste key ke chat/git.
# • GEMINI_MODEL sudah di-set ke model yang tepat; biarkan.
