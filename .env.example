# Copy to .env or .env.local and replace values with local credentials.
# Never commit populated environment files or expose server secrets to the browser.

# Required: PostgreSQL (Neon or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/financial_planner

# Required: generate a random secret of at least 32 characters.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: used by receipt OCR, gold image scanning, and the financial advisor.
GEMINI_API_KEY=
# Defaults in code: gemini-3.5-flash-lite and gemini-3.1-flash-lite.
GEMINI_MODEL=
GEMINI_MODEL_FALLBACKS=

# Optional for receipt OCR image storage.
BLOB_READ_WRITE_TOKEN=

# Optional gold market provider overrides.
# Defaults to https://emas.maulanar.my.id; the API key may be omitted if not required.
GOLD_PRICE_API_BASE_URL=
GOLD_PRICE_API_KEY=
